# Placeholders only. Copy to .env (gitignored) and fill in locally; never commit real values.
DATABASE_URL=postgresql://<user>:<password>@localhost:5433/<database>
DIRECT_URL=postgresql://<user>:<password>@localhost:5433/<database>
# Required in production (at least 32 characters).
JWT_SECRET=<random, at least 32 characters>
# ZP-507 "Love it" hearts: HMAC key for the anonymous dedupe hash. Required in
# production (at least 32 characters; UAT: Secret Manager grace-shop-uat-loves-hash-secret).
# Optional in development / test (a key derived from JWT_SECRET is used).
LOVES_HASH_SECRET=<random, at least 32 characters>
