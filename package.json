{
  "name": "shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "db:push": "node scripts/lib/db-safety.js db:push && prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:reset": "node scripts/lib/db-safety.js db:reset && prisma migrate reset --force --skip-seed",
    "migrate": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "postinstall": "prisma generate",
    "init": "node scripts/init-system.js",
    "init:fresh": "node scripts/init-system.js --reset",
    "import:august": "tsx scripts/import-august-trip.ts",
    "analytics:rollup": "tsx scripts/analytics-rollup.ts",
    "user:set": "node scripts/set-user.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "fflate": "^0.8.3",
    "jose": "^6.0.11",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
