// Prisma schema for Business Control MVP
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Authentication ────────────────────────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String // bcrypt hashed
  fullName  String
  role      String   @default("STAFF") // OWNER or STAFF
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Settings ──────────────────────────────────────────────────────────────────

model ExchangeRate {
  id            Int      @id @default(autoincrement())
  rmbToUsd      Float // e.g. 0.14 means 1 RMB = 0.14 USD
  effectiveDate DateTime
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())
}

// ─── Products & Stock ──────────────────────────────────────────────────────────

model Product {
  id                   Int      @id @default(autoincrement())
  itemNumber           String   @unique
  productName          String
  imageUrl             String? // Path to product image
  unitCostRmb          Float    @default(0)
  unitCostUsd          Float    @default(0)
  sellingPriceRmb      Float    @default(0)
  sellingPriceUsd      Float    @default(0)
  // Wholesale (ZP-475). Float to match the other money columns. No default:
  // NULL means "not set yet", which must not be confused with a price of 0.
  wholesalePriceUsd    Float?
  // Minimum quantity at which wholesalePriceUsd applies (>= 1 when set).
  wholesaleMinQuantity Int?
  openingQuantity      Int      @default(0)
  currentQuantity      Int      @default(0)
  notes                String?
  sourceImportId       Int?
  sourceFilename       String?
  sourceSheetName      String?
  sourceRowNumber      Int?
  createdBy            String?
  updatedBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // ─── Storefront / VYRA website (ZP-482). See docs/storefront/data-model.md.
  // None of these touch stock or cost. Only published products are public.
  published         Boolean      @default(false)
  // First time the product was published. Kept when it is unpublished, so
  // republishing does not make it a "new arrival" again.
  publishedAt       DateTime?
  publicName        String? // falls back to productName
  slug              String?      @unique
  publicDescription String?
  categoryId        Int?
  priceDisplay      PriceDisplay @default(ASK_FOR_PRICE)
  featured          Boolean      @default(false)
  sortOrder         Int          @default(0)
  colours           String? // free text until real variants exist
  sizes             String? // free text until real variants exist

  stockMovements StockMovement[]
  saleItems      SaleItem[]
  category       Category?             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  slugRedirects  ProductSlugRedirect[]
  video          ProductVideo?
  // ZP-508: verified customer reviews (owner-moderated) and their one-time links.
  reviews        Review[]
  reviewInvites  ReviewInvite[]

  @@index([categoryId])
}

// ─── Product video (ZP-501). See docs/storefront/videos.md.
// At most one per product, always optional: publishing still needs a photo.
// Public only while READY and the product is public.
enum ProductVideoStatus {
  PROCESSING
  READY
  FAILED
}

model ProductVideo {
  id              Int                @id @default(autoincrement())
  productId       Int                @unique
  status          ProductVideoStatus @default(PROCESSING)
  // Storage keys, e.g. videos/<32 hex>.mp4 and videos/<32 hex>.webp; null
  // until a first video is READY. A replacement does not touch them (nor the
  // READY status) until the new video is stored, so the public video never
  // has a gap; a failed replacement leaves them as they were.
  videoKey        String?
  posterKey       String?
  width           Int?
  height          Int?
  durationMs      Int?
  sizeBytes       Int?
  // Owner-facing reason when status is FAILED.
  error           String?
  // Processing lock (any instance): the upload being processed right now and
  // when it started. Set for first uploads (status PROCESSING) AND
  // replacements (status stays READY); a second upload while it is set and
  // fresh (< 10 min) is refused with 409. Processing finishes with an update
  // conditional on this id, so a video removed (row deleted) or taken over
  // meanwhile is never brought back.
  uploadId        String?
  uploadStartedAt DateTime?
  createdBy       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([videoKey])
  @@index([posterKey])
}

// How the public site shows the price. The public price is sellingPriceUsd.
enum PriceDisplay {
  SHOW_PRICE
  ASK_FOR_PRICE
}

model Category {
  id           Int      @id @default(autoincrement())
  name         String
  slug         String   @unique
  description  String?
  heroImageKey String? // storage key, e.g. products/<32 hex>.webp
  sortOrder    Int      @default(0)
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products Product[]
}

// Storefront gallery: the source of truth for the public site. The primary
// row mirrors Product.imageUrl, which the admin still uses. Keep the two in
// sync with src/lib/storefront-model/db.ts. "At most one primary per product"
// is the partial unique index ProductImage_one_primary_per_product, which
// exists only in the migration SQL (Prisma 6 cannot declare partial indexes).
model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  imageKey  String // storage key, e.g. products/<32 hex>.webp
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, imageKey])
  @@index([productId, sortOrder])
}

// An old product slug that still resolves. It points at the product, not at
// another slug, so redirects never chain or loop.
model ProductSlugRedirect {
  id        Int      @id @default(autoincrement())
  oldSlug   String   @unique
  productId Int
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model StockMovement {
  id             Int      @id @default(autoincrement())
  productId      Int
  movementDate   DateTime
  movementType   String // OPENING_BALANCE, SALE, PURCHASE, RETURN, ADJUSTMENT
  quantity       Int // positive for in, negative for out
  openingBalance Int      @default(0)
  closingBalance Int      @default(0)
  referenceType  String? // SALE, EXPENSE, IMPORT, MANUAL
  referenceId    Int?
  notes          String?
  sourceImportId Int?
  createdBy      String?
  createdAt      DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
}

// ─── Sales ─────────────────────────────────────────────────────────────────────

model Sale {
  id            Int      @id @default(autoincrement())
  saleDate      DateTime
  paymentType   String // CASH, CREDIT, MIXED
  customerName  String?
  customerPhone String?
  totalAmount   Float    @default(0)
  cashAmount    Float    @default(0)
  creditAmount  Float    @default(0)
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())

  items SaleItem[]
}

model SaleItem {
  id          Int      @id @default(autoincrement())
  saleId      Int
  productId   Int
  quantity    Int
  unitPrice   Float
  totalAmount Float
  createdAt   DateTime @default(now())

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

// ─── Expenses ──────────────────────────────────────────────────────────────────

model Expense {
  id            Int      @id @default(autoincrement())
  expenseDate   DateTime
  category      String
  description   String
  amount        Float
  paymentMethod String   @default("CASH") // CASH, BANK, OTHER
  paidTo        String?
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())
}

// ─── Cash Position ─────────────────────────────────────────────────────────────

model CashPosition {
  id                     Int      @id @default(autoincrement())
  cashDate               DateTime @unique
  openingCash            Float    @default(0)
  cashSales              Float    @default(0)
  debtorPaymentsReceived Float    @default(0)
  otherCashIn            Float    @default(0)
  expensesPaid           Float    @default(0)
  creditorPaymentsMade   Float    @default(0)
  expectedClosingCash    Float    @default(0)
  actualCountedCash      Float?
  variance               Float?
  notes                  String?
  createdBy              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// ─── Debtors (Credit Sales) ────────────────────────────────────────────────────

model Debtor {
  id                 Int      @id @default(autoincrement())
  customerName       String
  phoneNumber        String?
  totalCreditAmount  Float    @default(0)
  totalPaid          Float    @default(0)
  outstandingBalance Float    @default(0)
  status             String   @default("OPEN") // OPEN, PART_PAID, PAID
  notes              String?
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  transactions DebtorTransaction[]
}

model DebtorTransaction {
  id              Int      @id @default(autoincrement())
  debtorId        Int
  transactionDate DateTime
  transactionType String // CREDIT_SALE, PAYMENT
  amount          Float
  referenceType   String? // SALE, MANUAL
  referenceId     Int?
  notes           String?
  createdBy       String?
  createdAt       DateTime @default(now())

  debtor Debtor @relation(fields: [debtorId], references: [id])
}

// ─── Creditors (Suppliers) ─────────────────────────────────────────────────────

model Creditor {
  id                 Int       @id @default(autoincrement())
  creditorName       String
  phoneNumber        String?
  description        String?
  totalAmountOwed    Float     @default(0)
  totalPaid          Float     @default(0)
  outstandingBalance Float     @default(0)
  dueDate            DateTime?
  status             String    @default("OPEN") // OPEN, PART_PAID, PAID
  notes              String?
  createdBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  transactions CreditorTransaction[]
}

model CreditorTransaction {
  id              Int      @id @default(autoincrement())
  creditorId      Int
  transactionDate DateTime
  transactionType String // PURCHASE, PAYMENT
  amount          Float
  referenceType   String?
  referenceId     Int?
  notes           String?
  createdBy       String?
  createdAt       DateTime @default(now())

  creditor Creditor @relation(fields: [creditorId], references: [id])
}

// ─── Day Closing ───────────────────────────────────────────────────────────────

model DayClosing {
  id                     Int      @id @default(autoincrement())
  closingDate            DateTime @unique
  openingCash            Float    @default(0)
  totalCashSales         Float    @default(0)
  totalCreditSales       Float    @default(0)
  totalExpenses          Float    @default(0)
  debtorPaymentsReceived Float    @default(0)
  creditorPaymentsMade   Float    @default(0)
  expectedClosingCash    Float    @default(0)
  actualCountedCash      Float?
  cashVariance           Float?
  totalItemsSold         Int      @default(0)
  stockNotes             String?
  signOffName            String?
  closingNotes           String?
  status                 String   @default("DRAFT") // DRAFT, CLOSED
  closedBy               String?
  createdBy              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// ─── Import System ─────────────────────────────────────────────────────────────

model ImportDocument {
  id               Int       @id @default(autoincrement())
  filename         String
  documentType     String // PRODUCT_LIST, OPENING_STOCK, BUSINESS_CONTROL
  status           String    @default("DRAFT") // DRAFT, COMPLETED, FAILED, CANCELLED
  importedBy       String?
  totalRows        Int       @default(0)
  importedRows     Int       @default(0)
  skippedRows      Int       @default(0)
  errorRows        Int       @default(0)
  exchangeRateUsed Float?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  rows   ImportRow[]
  errors ImportError[]
}

model ImportRow {
  id                 Int      @id @default(autoincrement())
  importDocumentId   Int
  sheetName          String?
  rowNumber          Int
  detectedRecordType String?
  rawData            String? // JSON string of raw row data
  mappedData         String? // JSON string of mapped data
  status             String   @default("PENDING") // PENDING, READY, WARNING, ERROR, IMPORTED, SKIPPED
  errorMessage       String?
  createdAt          DateTime @default(now())

  importDocument ImportDocument @relation(fields: [importDocumentId], references: [id])
  errors         ImportError[]
}

model ImportError {
  id               Int      @id @default(autoincrement())
  importDocumentId Int
  importRowId      Int?
  errorType        String // MISSING_FIELD, INVALID_NUMBER, DUPLICATE, VALIDATION
  errorMessage     String
  createdAt        DateTime @default(now())

  importDocument ImportDocument @relation(fields: [importDocumentId], references: [id])
  importRow      ImportRow?     @relation(fields: [importRowId], references: [id])
}

// ─── Website: site settings (ZP-486) ───────────────────────────────────────────
// Single row (id = 1, enforced by a CHECK constraint in the migration). Edited
// by the OWNER at /website/settings; read publicly via getPublicSiteSettings().
// Validation: src/lib/site-settings/validate.ts. See docs/storefront/site-settings.md.

model SiteSettings {
  id Int @id @default(1)

  // Contacts
  whatsappNumber        String? // E.164, e.g. +263771234567
  enquiryTemplate       String  @default("Hi VYRA, I'm interested in {product} ({url})")
  generalEnquiryMessage String  @default("Hi VYRA, I'd like to ask about your collection.")
  phone                 String?
  email                 String?

  // Visit us
  address      String?
  openingHours Json? // { mon: { closed, open: "HH:MM", close: "HH:MM" }, ... sun }; null = not set
  holidayNote  String?
  mapUrl       String?
  latitude     Float?
  longitude    Float?

  // Social
  instagramUrl String?
  facebookUrl  String?
  tiktokUrl    String?

  // About
  aboutHeadline String?
  aboutStory    String?
  aboutImageKey String?

  // Home
  heroHeadline        String  @default("Style Your Way")
  heroSubline         String  @default("Premium fashion. Modern you.")
  heroImageKeyDesktop String?
  heroImageKeyMobile  String?
  statement           String  @default("Confidence in every stitch")
  trustLabel1         String  @default("Premium Quality")
  trustLabel2         String  @default("Visit Our Store")
  trustLabel3         String  @default("Enquire on WhatsApp")

  // SEO defaults
  seoTitle         String  @default("VYRA")
  seoDescription   String  @default("Premium fashion. Modern you.")
  seoShareImageKey String?

  // Availability / product display
  fewLeftThreshold Int     @default(3)
  showItemNumber   Boolean @default(false)

  // Reviews (ZP-508): optional "Review us on Google" link on the thank-you screen.
  googleReviewUrl String?

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── First-party analytics (ZP-493) ────────────────────────────────────────────
// Anonymous: no names, phone numbers, accounts, IP addresses or user agents.
// visitId (sessionStorage) and deviceId (localStorage) are random UUIDs made
// in the browser. Raw events are kept 90 days, the daily rollups 25 months
// (npm run analytics:rollup). No foreign keys on purpose: deleting a product
// never blocks on analytics, and old rows keep their numbers.
// See docs/storefront/analytics.md (event catalogue, columns, retention).

/// One event from the storefront tracker (POST /api/public/events).
model AnalyticsEvent {
  id         BigInt   @id @default(autoincrement())
  /// Random UUID made by the browser per event: a retried or replayed batch is stored once (createMany skipDuplicates).
  eventId    String   @unique @db.Uuid
  /// When it happened (client clock; replaced by receivedAt when more than 24 h back or 5 min ahead).
  occurredAt DateTime
  receivedAt DateTime @default(now())
  /// Analytics day of occurredAt in Africa/Harare. Retention and rollups go by this.
  day        DateTime @db.Date
  visitId    String   @db.Uuid
  /// Null when the browser blocks localStorage.
  deviceId   String?  @db.Uuid
  /// One of ANALYTICS_EVENT_TYPES (src/lib/analytics/events.ts).
  type       String   @db.VarChar(32)
  /// The piece, when the event is about one (checked against published pieces at ingest).
  slug       String?  @db.VarChar(80)
  /// Product.id resolved from slug at ingest, so a later slug change keeps history together.
  productId  Int?
  /// Path without query string or /site prefix, e.g. "/" or "/p/linen-dress".
  page       String?  @db.VarChar(200)
  /// Feed tab: "new" or a category slug.
  collection String?  @db.VarChar(80)
  /// Type-specific props, validated against EVENT_SPECS.
  props      Json     @default("{}")

  @@index([day, type])
  @@index([productId, day])
  @@index([visitId])
}

/// One row per analytics day: the whole site.
model AnalyticsDailyVisits {
  day             DateTime @id @db.Date
  /// Visits that started this day (visit_start).
  visits          Int      @default(0)
  /// Distinct device ids among them (null ids not counted).
  devices         Int      @default(0)
  /// Visits whose device had visited before.
  returningVisits Int      @default(0)
  /// Visits with at least one visit_end (the rest closed without one).
  endedVisits     Int      @default(0)
  /// Ended under 5 visible seconds having seen at most one look.
  bounces         Int      @default(0)
  /// Sum of visible seconds (latest visit_end of each visit).
  totalSeconds    Float    @default(0)
  /// Sum of looks seen per visit.
  looksSeen       Int      @default(0)
  /// Visits with at least one whatsapp_enquire.
  enquiringVisits Int      @default(0)
  updatedAt       DateTime @default(now()) @updatedAt
}

/// Visits per day by referrer bucket, device class and campaign tag.
model AnalyticsDailySource {
  day             DateTime @db.Date
  /// instagram | tiktok | whatsapp | facebook | google | direct | other
  source          String   @db.VarChar(16)
  /// phone | tablet | desktop
  deviceClass     String   @db.VarChar(16)
  /// ?src= / utm tag, "" when none.
  campaign        String   @default("") @db.VarChar(64)
  visits          Int      @default(0)
  bounces         Int      @default(0)
  enquiringVisits Int      @default(0)
  totalSeconds    Float    @default(0)

  @@id([day, source, deviceClass, campaign])
}

/// Per piece per day (ZP-505 Insights, ZP-506 ranking). Keyed by productId; slug is the latest seen.
model AnalyticsDailyPiece {
  day             DateTime @db.Date
  productId       Int
  slug            String   @db.VarChar(80)
  /// look_view events / distinct visits with one.
  views           Int      @default(0)
  viewers         Int      @default(0)
  /// Sum and number of look_dwell events (average = dwellSeconds / dwellCount).
  dwellSeconds    Float    @default(0)
  dwellCount      Int      @default(0)
  photoViews      Int      @default(0)
  videoStarts     Int      @default(0)
  detailsShows    Int      @default(0)
  productOpens    Int      @default(0)
  sizeSelects     Int      @default(0)
  colourSelects   Int      @default(0)
  galleryZooms    Int      @default(0)
  enquiries       Int      @default(0)
  restockRequests Int      @default(0)
  shares          Int      @default(0)
  loveOn          Int      @default(0)
  loveOff         Int      @default(0)
  /// Visits whose last look (latest visit_end of the day) was this piece.
  exits           Int      @default(0)

  @@id([day, productId])
  @@index([productId, day])
}

/// Per photo per day: photo index (1-based) and image file name ("" when not sent).
model AnalyticsDailyPhoto {
  day          DateTime @db.Date
  productId    Int
  photoIndex   Int
  image        String   @default("") @db.VarChar(64)
  slug         String   @db.VarChar(80)
  views        Int      @default(0)
  viewers      Int      @default(0)
  dwellSeconds Float    @default(0)
  dwellCount   Int      @default(0)

  @@id([day, productId, photoIndex, image])
  @@index([productId, day])
}

/// Per product video per day.
model AnalyticsDailyVideo {
  day          DateTime @db.Date
  productId    Int
  slug         String   @db.VarChar(80)
  starts       Int      @default(0)
  /// Distinct visits that started it.
  viewers      Int      @default(0)
  replays      Int      @default(0)
  reached25    Int      @default(0)
  reached50    Int      @default(0)
  reached75    Int      @default(0)
  reached100   Int      @default(0)
  watchSeconds Float    @default(0)

  @@id([day, productId])
  @@index([productId, day])
}

// ─── Customer reviews (ZP-508). See docs/storefront/reviews.md.
// Only verified buyers can review: the OWNER creates a one-time link
// (ReviewInvite) and sends it on WhatsApp. Only the SHA-256 hash of the
// link's token is stored. Every review is PENDING until the owner approves
// it; the storefront only ever reads APPROVED reviews. The admin cannot
// author reviews (no API creates a Review except the public token submit).

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

model ReviewInvite {
  id           Int       @id @default(autoincrement())
  /// sha256(token) as 64 lowercase hex. The token itself is never stored.
  tokenHash    String    @unique
  /// null = shop-only review link.
  productId    Int?
  /// Optional first name the owner typed, to prefill the form.
  customerHint String?
  expiresAt    DateTime
  /// Set atomically when the review is submitted (single use).
  usedAt       DateTime?
  /// A photo the customer uploaded with this link but has not submitted yet.
  photoKey     String?
  createdBy    String
  createdAt    DateTime  @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  review  Review?

  @@index([productId])
}

model Review {
  id           Int          @id @default(autoincrement())
  inviteId     Int          @unique
  /// null = shop-only review (then `stars` is the shop rating).
  productId    Int?
  /// 1-5: the piece (or the shop for a shop-only review).
  stars        Int
  /// 1-5, optional: the shop, given alongside a piece review.
  shopStars    Int?
  /// Plain text, 10-1000 characters. Rendered escaped, never as HTML or links.
  comment      String
  /// "Tendai M.", derived from the name the customer typed (the full name is not stored).
  displayName  String
  photoKey     String?
  /// Shown publicly only when true AND the review is APPROVED.
  photoConsent Boolean      @default(false)
  status       ReviewStatus @default(PENDING)
  /// Simple word-list match at submit; shown to the owner only.
  flagged      Boolean      @default(false)
  ownerReply   String?
  ownerReplyAt DateTime?
  /// Owner-only note when hiding a review. Never public.
  privateNote  String?
  approvedAt   DateTime?
  moderatedBy  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  invite  ReviewInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  product Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, productId])
  @@index([photoKey])
}
